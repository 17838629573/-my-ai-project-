{
  "meta": {
    "project": "安全生产宣教短片",
    "version": "1.0",
    "principle": "制作前锁定全部资源。开工后只引用，不临时生成。",
    "locked_at": "未锁定（待确认）"
  },

  "style_lock": {
    "_why": "风格锁解决的是跨资源一致性。生成时逐条写进提示词，不靠后期补救。",
    "grid_lock": {
      "unit": "角色按 512x768 出图，背景按 1080x1920，前景按 1080x400",
      "note": "同一角色的所有状态必须同尺寸同构图，否则替换时错位"
    },
    "light_lock": {
      "source": "顶光偏冷，设备暖光点缀",
      "direction": "top-left",
      "shadow_direction": "bottom-right",
      "note": "全场唯一光源方向。这是合成不穿帮的第一要素"
    },
    "color_lock": {
      "palette": ["#2B3240", "#4A5568", "#8A94A6", "#C8CDD4"],
      "accent_warm": "#E8A33D",
      "accent_safety": "#C8E04A",
      "note": "安全服黄绿为高亮色，只给反光工装用"
    },
    "background_lock": {
      "mode": "transparent",
      "key_color": null,
      "note": "角色层一律透明背景PNG。纯色背景可走色度键（实测可识别率70%），照片背景为0%"
    },
    "render_lock": {
      "flat_levels": "32-64",
      "note": "实测：低于16色阶带状瑕疵涨2.6倍，且文件反而更大。32-64是安全区"
    }
  },

  "naming": {
    "pattern": "{role}_{subject}_{state}_{frame:02d}.png",
    "examples": ["char_worker_a_reach_out_01.png", "bg_workshop_main.png"],
    "rules": [
      "全小写 + 下划线",
      "帧号零填充（01/02），保证排序正确",
      "状态名即代码里的状态ID，一一对应"
    ]
  },

  "assets": {
    "characters": {
      "worker_a": {
        "desc": "蓝工装，中间，劝阻者（伸手阻拦）",
        "z": 2,
        "alpha": true,
        "states": {
          "idle":       {"frames": 1, "fps": 1,  "purpose": "待机，全片复用"},
          "reach_out":  {"frames": 3, "fps": 12, "purpose": "伸手阻拦（起手/伸展/到位）"},
          "push_back":  {"frames": 2, "fps": 12, "purpose": "推挡"},
          "gesture":    {"frames": 3, "fps": 10, "purpose": "劝解手势，口播配合"}
        }
      },
      "worker_b": {
        "desc": "蓝工装，左侧，被劝者（欲动手）",
        "z": 2,
        "alpha": true,
        "states": {
          "idle":         {"frames": 1, "fps": 1,  "purpose": "待机"},
          "raise_fist":   {"frames": 3, "fps": 12, "purpose": "举拳（起手/蓄力/到顶）"},
          "step_forward": {"frames": 3, "fps": 12, "purpose": "前冲"},
          "restrained":   {"frames": 2, "fps": 10, "purpose": "被拦住后僵持"}
        }
      },
      "worker_c": {
        "desc": "黄绿反光工装，右侧，拉架者",
        "z": 2,
        "alpha": true,
        "states": {
          "idle":     {"frames": 1, "fps": 1,  "purpose": "待机"},
          "grab_arm": {"frames": 3, "fps": 12, "purpose": "抓住对方手臂"},
          "pull_back": {"frames": 2, "fps": 10, "purpose": "往后拉"}
        }
      },
      "face": {
        "desc": "面部细节层（可选，叠加到角色头部区域）",
        "z": 3,
        "alpha": true,
        "states": {
          "mouth_neutral": {"frames": 1, "fps": 1, "purpose": "闭口"},
          "mouth_open":    {"frames": 1, "fps": 1, "purpose": "张口（口型A）"},
          "mouth_wide":    {"frames": 1, "fps": 1, "purpose": "大张（口型O）"},
          "mouth_closed":  {"frames": 1, "fps": 1, "purpose": "抿嘴（M/B/P）"},
          "eye_open":      {"frames": 1, "fps": 1, "purpose": "睁眼"},
          "eye_half":      {"frames": 1, "fps": 1, "purpose": "半闭（眨眼过渡）"}
        }
      }
    },

    "backgrounds": {
      "bg_workshop_main":  {"frames": 1, "z": 0, "parallax": 0.08, "purpose": "车间主背景，全片复用"},
      "bg_workshop_wide":  {"frames": 1, "z": 0, "parallax": 0.08, "purpose": "广角版，用于开场/收尾"},
      "bg_machine_wall":   {"frames": 1, "z": 1, "parallax": 0.15, "purpose": "中景设备墙，增加视差层次"}
    },

    "foregrounds": {
      "fg_pipe_edge":   {"frames": 1, "z": 4, "parallax": 0.30, "purpose": "管道边缘，前景遮挡"},
      "fg_railing":     {"frames": 1, "z": 4, "parallax": 0.30, "purpose": "护栏，前景"}
    },

    "props": {
      "prop_helmet":  {"frames": 1, "z": 2, "purpose": "安全帽，可佩戴/手持"},
      "prop_glove":   {"frames": 1, "z": 2, "purpose": "手套"},
      "fx_impact":    {"frames": 3, "fps": 24, "z": 5, "purpose": "撞击特效（可选）"}
    }
  },

  "packing": {
    "layout": "animation_rows",
    "note": "每个状态占一行，帧从左到右。业界标准布局之一，便于手工选帧",
    "trim": true,
    "gutter_px": 2,
    "extrude_px": 2,
    "extrude_note": "边缘像素外扩，否则缩放采样时会出现邻帧渗色",
    "metadata": "导出同名 .json，含每帧 rect / pivot / frameTags"
  }
}
