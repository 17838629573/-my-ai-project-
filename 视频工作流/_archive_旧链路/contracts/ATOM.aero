api: cloth_aero.wind_force(area_m2,v_wind,nx,ny,v_face) | cloth_aero.will_blow_off(area_m2,v_wind,mass_kg,nx,ny) | cloth_aero.self_check() | cloth_wire.garment_geom(spec_obj) | cloth_wire.garment_state(area_m2,mass_kg,v_wind,nx,ny) | cloth_wire.garment_amp_m(spec_obj,v_wind,family,L_char_m,nx,ny) | cloth_wire.self_check() | wind_response.family_freq(family,L,u) | wind_response.family_amp(family,L,u) | wind_response.wind_response(family,L,u,regime) …
