[M] ATOM/rule  S=4: photo_rules,param_decl,actors,_family_map
api: photo_rules.body_pixels(shot,H,headroom) | photo_rules.ground_y(shot,H,char_h,footroom) | photo_rules.head_top_y(shot,H,char_h,ground) | photo_rules.validate_shot(shot_type,angle,movement,H,W) | param_decl.verify(pname,p) | param_decl.require(pname,family,why,unit_hint,hint) | param_decl.have(pname) | param_decl.save(pname,value,unit,source,rng,family) | actors.require(action,actor) | actors.check_shot(name,decl) …
rule: T88 T100 T101 T99 T16 T11
uses: ATOM/phys
usedby: ATOM/aero,ATOM/cam,OPS/demo,SHOT/assemble,SHOT/sheet,SOLVE/chain
inner=0  selftest=4/4
