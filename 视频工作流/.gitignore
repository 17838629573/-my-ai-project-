# 产物不入库（可重跑，推上去只会膨胀仓库）
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.m4v
*.flv

# 字节码
__pycache__/
*.pyc
*.pyo

# 归档与生成图
_生成/
_archive_旧链路/

# refcheck 联网缓存（运行时生成）
.refcache/
.refcache.json

# import-linter 磁盘缓存（运行时生成，含 CACHEDIR.TAG）
.import_linter_cache/
.import_linter_cache.json

# 门禁分批运行状态（运行时生成）
.batchgate.json
.bg_full.json
.bg_self.json

# faultbench 临时 canary（异常退出会残留，不该入库）
_canary_faultbench*
